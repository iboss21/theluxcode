# ── Like a King Inc. — VPS production stack env ──────────────────────────────
# Copy to `.env` in this folder, fill in every value, then `docker compose ...`.
# Generate strong secrets with the commands shown; never commit the real .env.

# ── Domains (point each A record at this server's IP) ───────────────────────
APP_DOMAIN=likeakinginc.com
CRM_DOMAIN=crm.likeakinginc.com
INVOICING_DOMAIN=invoices.likeakinginc.com
BOOKING_DOMAIN=book.likeakinginc.com

# ── The app (website + operations console) ──────────────────────────────────
# Admin password for the console at APP_DOMAIN/admin
CRM_PASSWORD=change-me-to-a-strong-password
# Signs the admin session cookie.  Generate:  openssl rand -hex 32
SESSION_SECRET=change-me-long-random

# Paste these back into the console → Settings → Integrations so it opens the
# real tools inside Invoices / Bookings / Customers:
INVOICING_URL=https://invoices.likeakinginc.com
BOOKING_URL=https://book.likeakinginc.com
CRM_URL=https://crm.likeakinginc.com

# AI brain (optional; can also be set live in the admin → AI · REGES)
BRAIN_PROVIDER=off
BRAIN_API_KEY=
BRAIN_MODEL=

# Email (used by the app AND Invoice Ninja)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@likeaking.pro
SMTP_PASS=
MAIL_FROM_NAME=Like a King Inc.
MAIL_FROM_EMAIL=info@likeaking.pro
TEAM_INBOX=info@likeaking.pro

# ── EspoCRM (real CRM) ──────────────────────────────────────────────────────
ESPO_DB_ROOT_PASSWORD=change-me
ESPO_DB_PASSWORD=change-me
ESPO_ADMIN_USER=admin
ESPO_ADMIN_PASSWORD=change-me

# ── Invoice Ninja (real invoicing) ──────────────────────────────────────────
IN_DB_ROOT_PASSWORD=change-me
IN_DB_PASSWORD=change-me
# REQUIRED. Generate:  echo "base64:$(openssl rand -base64 32)"
IN_APP_KEY=

# ── Cal.com (real booking) ──────────────────────────────────────────────────
CAL_DB_PASSWORD=change-me
# Generate each:  openssl rand -base64 32   (encryption key must be 32 chars)
CAL_NEXTAUTH_SECRET=
CAL_ENCRYPTION_KEY=
