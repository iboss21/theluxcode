# Like a King Inc. — one Node app. Copy to .env (or set in Hostinger's env vars).
# Everything is optional; with nothing set it runs on deterministic fallbacks.

# Admin panel login
CRM_PASSWORD=changeme
# or a bcrypt hash (preferred): node -e "console.log(require('bcryptjs').hashSync('pass',10))"
CRM_PASSWORD_HASH=
SESSION_SECRET=please-change-to-a-long-random-string

# Lead store location (persistent, writable). Default: ./data
DATA_DIR=./data

# AI brain — you can ALSO set this live from the admin panel (AI Settings).
# provider: off | groq | openrouter | gemini | cerebras | mistral | together | openai | anthropic
BRAIN_PROVIDER=off
BRAIN_API_KEY=
BRAIN_MODEL=
BRAIN_BASE_URL=
BRAIN_TIMEOUT_MS=25000

# Email (best-effort; blank = leads still saved and shown in the admin)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@likeaking.pro
SMTP_PASS=
MAIL_FROM_NAME=Like a King Inc.
MAIL_FROM_EMAIL=info@likeaking.pro
TEAM_INBOX=info@likeaking.pro

# Armory tool orchestrator (VPS with Docker). Mount the socket into the app.
DOCKER_SOCKET=/var/run/docker.sock

PORT=3000
