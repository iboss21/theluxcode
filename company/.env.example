# ─────────────────────────────────────────────────────────────────────────────
# Like a King Inc. — company platform + REGES brain
# Copy to `.env.local` for dev, or set as real env vars in production.
# EVERYTHING here is optional: with nothing set, the app runs fully on its
# deterministic fallbacks (rate-card pricing, scripted concierge, no email).
# ─────────────────────────────────────────────────────────────────────────────

# ── Data store ───────────────────────────────────────────────────────────────
# Where the JSON lead/CRM store lives. Default: ./.data/store.json
# For a real VPS keep this on a persistent, writable path.
DATA_DIR=./.data

# ── CRM login (single password) ──────────────────────────────────────────────
# Set ONE of these. A bcrypt hash is preferred.
#   node -e "console.log(require('bcryptjs').hashSync('your-strong-pass',10))"
CRM_PASSWORD_HASH=
# ...or a plain password (dev only). Hash wins if both are set.
CRM_PASSWORD=changeme
# Secret used to sign the session cookie. Set a long random string in prod.
SESSION_SECRET=please-change-this-to-a-long-random-string

# ── REGES brain (the AI layer) ───────────────────────────────────────────────
# provider: off | openai | anthropic
#   off       → deterministic rate card + scripted concierge (no model). Default.
#   openai    → any OpenAI-compatible endpoint: Odysseus / LM Studio / vLLM /
#               OpenAI / Together / Groq …  Set BRAIN_BASE_URL (+ key + model).
#   anthropic → Anthropic Messages API. Set BRAIN_API_KEY + BRAIN_MODEL.
BRAIN_PROVIDER=off
# For openai-compatible: the /v1 base. Examples:
#   Odysseus / local model server : http://127.0.0.1:8000/v1
#   LM Studio                     : http://127.0.0.1:1234/v1
#   OpenAI                        : https://api.openai.com/v1
BRAIN_BASE_URL=http://127.0.0.1:8000/v1
BRAIN_API_KEY=
BRAIN_MODEL=local-model
BRAIN_TIMEOUT_MS=25000

# ── Email (nodemailer, best-effort) ──────────────────────────────────────────
# Leave blank to skip email — leads are still saved and shown in the CRM.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@likeaking.pro
SMTP_PASS=
MAIL_FROM_NAME=Like a King Inc.
MAIL_FROM_EMAIL=info@likeaking.pro
TEAM_INBOX=info@likeaking.pro

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Like a King Inc.
